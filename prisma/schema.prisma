generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  CONTRACTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum RequirementStatus {
  OPEN
  QUOTED
  ACCEPTED
  ORDERED
  COMPLETED
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  role         UserRole   @default(BUYER)
  status       UserStatus @default(ACTIVE)

  // Lifetime free quotations used by a seller (limit is FREE_QUOTATION_LIMIT, default 10)
  freeQuotesUsed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyerProfile       BuyerProfile?
  sellerProfile      SellerProfile?
  deliveryAddresses  DeliveryAddress[]
  sellerQuotes       Quote[]
  requirements       Requirement[]
  
  subscriptions      SellerSubscription[]
  subscriptionOrders SubscriptionOrder[]
  buyerOrders        Order[]              @relation("BuyerOrders")
  sellerOrders       Order[]              @relation("SellerOrders")
  deviceTokens UserDeviceToken[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model UserDeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String?
  deviceName String?
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model RegistrationOtp {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  otpHash      String
  expiresAt    DateTime
  verified     Boolean  @default(false)
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

model BuyerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  phoneNumber     String?
  companyName     String?
  state           String
  city            String
  pincode         String
  completeAddress String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([city])
  @@index([pincode])
}

model DeliveryAddress {
  id     String @id @default(uuid())
  userId String

  label        String  @default("Construction Site")
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  orders       Order[]

  @@index([userId])
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  email     String   @unique
  otpHash   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
}

model MaterialCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials Material[]
}

model Material {
  id          String   @id @default(uuid())
  categoryId  String
  name        String
  description String?
  unit        String
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  requirements Requirement[]
  orders       Order[]

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
}

model Requirement {
  id                String @id @default(uuid())
  buyerId           String
  materialId        String
  deliveryAddressId String

  quantity Decimal @db.Decimal(12, 2)
  unit     String

  deliveryPreference String
  notes              String?

  status RequirementStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer           User            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  material        Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
  deliveryAddress DeliveryAddress @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  quotes          Quote[]
  orders          Order[]

  @@index([buyerId])
  @@index([materialId])
  @@index([deliveryAddressId])
  @@index([status])
  @@index([createdAt])
}

model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique

  ownerName    String
  businessName String
  businessType String

  gstRegistered Boolean @default(false)
  gstNumber     String?
  panNumber     String?

  phone String
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessName])
  @@index([businessType])
  @@index([gstNumber])
}

model Quote {
  id String @id @default(uuid())

  requirementId String
  sellerId      String

  pricePerUnit    Decimal @db.Decimal(12, 2)
  materialAmount  Decimal @db.Decimal(12, 2)
  deliveryCharges Decimal @db.Decimal(12, 2)
  totalAmount     Decimal @db.Decimal(12, 2)

  deliveryTime String
  validity     String
  message      String?

  status QuoteStatus @default(PENDING)

  // Which quota this quotation was charged to
  quotaSource    QuotaSource @default(FREE)
  subscriptionId String?
  order          Order?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  subscription SellerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([sellerId])
  @@index([status])
  @@index([subscriptionId])
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  DISPATCHED
}

enum QuotaSource {
  FREE
  SUBSCRIPTION
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum SubscriptionSource {
  PURCHASE
  ADMIN_GRANT
}

// Plans are data, not code: STANDARD / PLUS / PRO are seeded and editable by admin.
model SubscriptionPlan {
  id          String  @id @default(uuid())
  code        String  @unique // STANDARD | PLUS | PRO
  name        String
  description String?

  price    Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  quotationLimit Int // quotations included in one purchase
  validityDays   Int? // null = never expires

  hasTrustedBadge Boolean  @default(false) // true for PRO
  features        String[]
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions SellerSubscription[]
  orders        SubscriptionOrder[]

  @@index([isActive])
  @@index([sortOrder])
}

// One row per plan purchase (or admin grant). Values are snapshotted from the plan.
model SellerSubscription {
  id       String @id @default(uuid())
  sellerId String
  planId   String

  quotationsTotal     Int
  quotationsRemaining Int
  hasTrustedBadge     Boolean @default(false)

  status SubscriptionStatus @default(ACTIVE)
  source SubscriptionSource @default(PURCHASE)

  startsAt  DateTime  @default(now())
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  quotes Quote[]
  order  SubscriptionOrder?

  @@index([sellerId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

// One row per Cashfree order (a plan purchase attempt).
// Plan values are snapshotted so a later price change does not affect a paid order.
model SubscriptionOrder {
  id       String @id @default(uuid())
  orderId  String @unique // order_id we send to Cashfree
  sellerId String
  planId   String

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  quotationLimit  Int
  validityDays    Int?
  hasTrustedBadge Boolean @default(false)

  status PaymentStatus @default(CREATED)

  paymentSessionId String?
  cfOrderId        String?
  cfPaymentId      String?
  paymentMethod    String?
  paidAt           DateTime?

  subscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller       User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription SellerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([status])
}

model Order {
  id String @id @default(uuid())

  orderNumber String @unique

  requirementId String
  quoteId       String @unique
  buyerId       String
  sellerId      String

  materialId String

  quantity Decimal @db.Decimal(12, 2)
  unit     String

  pricePerUnit    Decimal @db.Decimal(12, 2)
  materialAmount  Decimal @db.Decimal(12, 2)
  deliveryCharges Decimal @db.Decimal(12, 2)
  totalAmount     Decimal @db.Decimal(12, 2)

  deliveryAddressId String

  driverName    String
  driverPhone   String
  vehicleNumber String

  dispatchDate         DateTime  @default(now())
  expectedDeliveryDate DateTime?

  deliveryNotes String?

  status OrderStatus @default(DISPATCHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  quote       Quote       @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  buyer  User @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller User @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)

  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  deliveryAddress DeliveryAddress @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)

  @@index([buyerId])
  @@index([sellerId])
  @@index([requirementId])
  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

